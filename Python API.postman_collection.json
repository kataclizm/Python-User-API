	"item": [
		{
			"name": "User Create",
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n\"first_name\": \"{{$guid}}\",\r\n\"last_name\": \"TEST\",\r\n\"email\": \"{{$guid}}@test.com\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{API_URL}}/users",
					"host": [
						"{{API_URL}}"
					],
					"path": [
						"users"
					]
				}
			},
			"response": []
		},
		{
			"name": "Get Users",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const jsonData = pm.response.json();\r",
							"\r",
							"pm.collectionVariables.set(\"USER_ID\", \"TEST\");\r",
							"\r",
							"if(jsonData.length > 0)\r",
							"{\r",
							"    // Get the ID of the last user created\r",
							"    pm.collectionVariables.set(\"USER_ID\", jsonData[jsonData.length-1][\"id\"]);\r",
							"}\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{API_URL}}/users",
					"host": [
						"{{API_URL}}"
					],
					"path": [
						"users"
					]
				}
			},
			"response": []
		},
		{
